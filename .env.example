# Public browser-safe Supabase project credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production origin used for canonical public share links and metadata.
# In the browser, sharing falls back to window.location.origin when omitted.
NEXT_PUBLIC_SITE_URL=https://hh-goa-2026-frame-generator-one.vercel.app/
